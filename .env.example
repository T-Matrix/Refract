# 必填：已经解析到 VPS 公网 IP 的域名
PROXY_DOMAIN=proxy.example.com

# 可选：默认 Emby。配置后客户端可以直接填写 https://proxy.example.com
DEFAULT_UPSTREAM=https://emby.example.com

# 允许用户直接拼接访问的初始上游。多个值用逗号分隔。
# 支持 example.com、example.com:443、*.example.com。
ALLOWED_UPSTREAMS=emby.example.com,emby2.example.com

# 必填：至少 32 字符。用于给自动发现的推流 URL 签名。
SIGNING_SECRET=

# 自动签名的推流链接有效期。
SIGNED_URL_TTL=24h

# 不建议开启。开启后任何人都可以代理任意公网 HTTP 目标。
ALLOW_UNSIGNED_TARGETS=false

# 仅当 Emby 位于 VPS 可访问的内网时开启。
ALLOW_PRIVATE_TARGETS=false

# 默认不向上游传递用户真实 IP。
PASS_CLIENT_IP=false

DISABLE_CACHE=true
REWRITE_MAX_BYTES=8388608
DNS_CACHE_TTL=1m
DIAL_TIMEOUT=15s
RESPONSE_HEADER_TIMEOUT=60s
TZ=Asia/Shanghai

# 管理面板：启用后访问 /login，登录后进入 /panel。
# ADMIN_PASSWORD_HASH 留空时，首次启动会引导你在 /setup 创建管理员。
ADMIN_ENABLED=false
ADMIN_USERNAME=admin
# 使用 `printf '%s\n' '你的密码' | go run ./cmd/hash-password` 生成。
ADMIN_PASSWORD_HASH=
# 至少 32 字符，建议使用 `openssl rand -hex 32`。
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL=12h
ADMIN_DATABASE_PATH=/data/gateway.db
# 留空时默认保存在数据库同级的 backups 目录。
ADMIN_BACKUP_DIR=

# Cloudflare Turnstile 由面板配置。密钥不会写入环境变量，服务端会加密保存。
# 保存配置后必须在“系统设置”完成一次配置自测，才能勾选启用登录验证。

# 访客地域查询。接口必须支持 {ip} 占位符并返回指定 IP；留空可关闭外部定位。
# IPPure 的公开 MyIP 接口只能查询调用者自身，不能用于这里。
GEOIP_LOOKUP_URL=https://ipwho.is/{ip}?fields=success,ip,country,country_code,region,latitude,longitude
GEOIP_LOOKUP_TIMEOUT=8s
GEOIP_LOOKUP_INTERVAL=1100ms

# 公网通用模式的资源保护。超过限制返回 429。
MAX_CONCURRENT_REQUESTS=64
MAX_CONCURRENT_PER_IP=12
